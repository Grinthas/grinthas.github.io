       "Loot slots",
       "21"
      ],
      [
       "Upgrade slots",
       "9"
      ],
      [
       "Cycle",
       "10 s without upgrades"
      ],
      [
       "Energy use",
       "800 RF per mob"
      ],
      [
       "Buffer",
       "1,000,000 RF, up to 20,000 RF/t input"
      ]
     ]
    },
    {
     "text": "The spawner pushes loot into adjacent chests, hoppers and pipes by itself. Experience is stored inside; take it with the Collect XP button."
    },
    {
     "heading": "Status"
    },
    {
